<%- include('header') %>

<section>
  <header>
    <h1>사념 기록 (Diary / Tech Blog)</h1>
  </header>

  <% if (user) { %>
    <!-- Toggle write form button -->
    <div style="margin-bottom: 20px;">
      <button type="button" class="submit-btn" id="toggleWriteBtn" onclick="toggleWriteForm()">새 사념 기록</button>
    </div>

    <!-- Diary Write Form -->
    <div id="writeFormContainer" style="display: none;">
      <div class="glass-borders" style="margin-bottom: 20px;">
        <div class="styled-containers aero-borders">
          <h2>새 사념 기록</h2>
          <form action="/post/new" method="POST" enctype="multipart/form-data" class="post-form">
            <input type="hidden" name="type" value="diary" />
            <div class="form-group">
              <label for="title">사념 제목</label>
              <input type="text" id="title" name="title" required placeholder="글 제목..." />
            </div>
            <div class="form-group">
              <label for="content">생각의 파편</label>
              <textarea id="content" name="content" required rows="7" placeholder="여기에 어둠과 코드를 기록한다..."></textarea>
            </div>
            <div class="form-group">
              <label for="image">이미지 첨부 (최대 1개)</label>
              <input type="file" id="image" name="image" accept="image/*" class="file-input" />
            </div>
            <button type="submit" class="submit-btn">기록 각인하기</button>
          </form>
        </div>
      </div>
    </div>

    <script>
      function toggleWriteForm() {
        var container = document.getElementById('writeFormContainer');
        var btn = document.getElementById('toggleWriteBtn');
        if (container.style.display === 'none') {
          container.style.display = 'block';
          btn.textContent = '기록 취소';
        } else {
          container.style.display = 'none';
          btn.textContent = '새 사념 기록';
        }
      }
    </script>
  <% } else { %>
    <div class="glass-borders" style="margin-bottom: 20px;">
      <div class="styled-containers aero-borders" style="text-align: center; color: #888; padding: 15px; font-size: 13.5px;">
        사념을 기록하려면 <a href="/login" style="color: var(--accent-color); font-weight: bold; text-decoration: underline;">로그인</a>이 필요합니다.
      </div>
    </div>
  <% } %>

  <!-- Filter notification if active -->
  <% if (locals.authorFilter) { %>
    <div class="glass-borders" style="margin-bottom: 20px;">
      <div class="styled-containers aero-borders" style="display: flex; justify-content: space-between; align-items: center; padding: 12px 15px;">
        <span style="color: #fff; font-size: 13.5px;">
          <strong style="color: var(--accent-color);"><%= authorFilter %></strong> 님의 사념 기록을 필터링 중입니다.
        </span>
        <a href="/diary" class="submit-btn" style="text-decoration: none; padding: 4px 12px; font-size: 12px;">전체 보기</a>
      </div>
    </div>
  <% } %>

  <!-- Diary list -->
  <div class="diary-list-container">
    <% if (posts && posts.length > 0) { %>
      <% posts.forEach(post => { %>
        <div class="glass-borders">
          <article class="styled-containers aero-borders">
            <div class="post-header" style="flex-direction: column; align-items: flex-start; gap: 4px;">
              <span class="post-title"><%= post.title %></span>
              <div style="display: flex; gap: 10px; font-size: 12px; color: var(--text-secondary);">
                <span style="display: inline-flex; align-items: center; gap: 4px;">작성자: 
                  <% const authorName = post.authorNickname || '운영자'; %>
                  <% if (locals.usersMap && usersMap[authorName]) { %>
                    <img src="<%= usersMap[authorName] %>" alt="Profile" style="width: 18px; height: 18px; border-radius: 50%; object-fit: cover; border: 1px solid var(--accent-color);" />
                  <% } %>
                  <a href="/diary?author=<%= encodeURIComponent(authorName) %>" 
                     title="<%= authorName %> 님의 글만 보기" 
                     style="color: var(--accent-color); font-weight: bold; text-decoration: underline;">
                    <%= authorName %>
                  </a>
                </span>
                <span>|</span>
                <span class="post-date" data-timestamp="<%= post.createdAt %>"></span>
              </div>
            </div>
            <div class="post-body diary-post-content" style="margin-top: 10px;">
              <% if (post.imageUrl) { %>
                <div class="post-image-container">
                  <a href="<%= post.imageUrl %>" class="lightbox-trigger" title="클릭하여 확대">
                    <img src="<%= post.imageUrl %>" alt="첨부 이미지" class="post-thumbnail" />
                  </a>
                </div>
              <% } %>
              <div class="post-text-content">
                <%= post.content %>
              </div>
            </div>
            
            <% 
              let canDelete = false;
              let deleteLabel = "삭제";
              if (isAdmin) {
                canDelete = true;
                deleteLabel = "삭제 (운영자)";
              } else if (user && (post.authorId === user.id || post.authorNickname === user.nickname)) {
                canDelete = true;
              }
            %>
            <% if (canDelete) { %>
              <div class="post-admin-actions" style="margin-top: 10px;">
                <form action="/post/<%= post.id %>/delete" method="POST">
                  <input type="hidden" name="redirectType" value="diary" />
                  <button type="submit" class="admin-del-btn" onclick="return confirm('이 기록을 영구 말살하시겠습니까?')"><%= deleteLabel %></button>
                </form>
              </div>
            <% } %>

            <!-- Comments Section -->
            <%- include('partials/comments', { post: post, redirectType: 'diary' }) %>
          </article>
        </div>
      <% }) %>
    <% } else { %>
      <div class="glass-borders">
        <div class="styled-containers aero-borders" style="text-align: center; color: #888; padding: 30px;">
          기록된 사념이 없습니다.
        </div>
      </div>
    <% } %>
  </div>

  <!-- Pagination Controls -->
  <%- include('partials/pagination', { 
      currentPage: currentPage, 
      totalPages: totalPages, 
      basePath: '/diary', 
      filterParam: authorFilter ? '&author=' + encodeURIComponent(authorFilter) : '' 
  }) %>
</section>

<%- include('footer') %>
