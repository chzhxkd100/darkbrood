<% if (totalPages > 1) { %>
  <div class="pagination-container" style="display: flex; justify-content: center; align-items: center; gap: 8px; margin-top: 25px; margin-bottom: 25px;">
    
    <!-- 처음 페이지로 이동 (<<) -->
    <% if (currentPage > 1) { %>
      <a href="<%= basePath %>?page=1<%= filterParam %>" class="submit-btn" style="text-decoration: none; padding: 6px 12px; font-size: 0.9rem;" title="처음 페이지">&lt;&lt;</a>
      <a href="<%= basePath %>?page=<%= currentPage - 1 %><%= filterParam %>" class="submit-btn" style="text-decoration: none; padding: 6px 12px; font-size: 0.9rem;" title="이전 페이지">&lt;</a>
    <% } %>

    <!-- 앞부분 생략 표시 (...) -->
    <% 
      let startPage = Math.max(1, currentPage - 4);
      let endPage = Math.min(totalPages, startPage + 8);
      if (endPage - startPage < 8) {
        startPage = Math.max(1, endPage - 8);
      }
    %>
    <% if (startPage > 1) { %>
      <span style="color: var(--text-secondary); padding: 0 4px;">...</span>
    <% } %>

    <!-- 페이지 번호 루프 -->
    <% for (let i = startPage; i <= endPage; i++) { %>
      <% if (i === currentPage) { %>
        <span class="submit-btn" style="padding: 6px 12px; font-size: 0.9rem; background: rgba(255,255,255,0.25); border-color: rgba(255,255,255,0.5); cursor: default; box-shadow: 0 0 10px rgba(255,255,255,0.3);"><%= i %></span>
      <% } else { %>
        <a href="<%= basePath %>?page=<%= i %><%= filterParam %>" class="submit-btn" style="text-decoration: none; padding: 6px 12px; font-size: 0.9rem;"><%= i %></a>
      <% } %>
    <% } %>

    <!-- 뒷부분 생략 표시 (...) -->
    <% if (endPage < totalPages) { %>
      <span style="color: var(--text-secondary); padding: 0 4px;">...</span>
    <% } %>

    <!-- 다음 및 끝 페이지로 이동 (>>) -->
    <% if (currentPage < totalPages) { %>
      <a href="<%= basePath %>?page=<%= currentPage + 1 %><%= filterParam %>" class="submit-btn" style="text-decoration: none; padding: 6px 12px; font-size: 0.9rem;" title="다음 페이지">&gt;</a>
      <a href="<%= basePath %>?page=<%= totalPages %><%= filterParam %>" class="submit-btn" style="text-decoration: none; padding: 6px 12px; font-size: 0.9rem;" title="마지막 페이지">&gt;&gt;</a>
    <% } %>

    <!-- 페이지 검색 및 이동 -->
    <div class="page-search-container" style="display: flex; align-items: center; gap: 5px; margin-left: 12px; border-left: 1px dashed rgba(255,255,255,0.2); padding-left: 12px;">
      <input type="number" id="pageSearchInput" min="1" max="<%= totalPages %>" placeholder="이동" 
             style="width: 50px; background: rgba(0,0,0,0.6); border: 1px solid rgba(255,255,255,0.15); border-radius: 4px; color: #fff; padding: 5px 8px; font-size: 0.85rem; outline: none; text-align: center; -moz-appearance: textfield; -webkit-appearance: none; margin: 0;" />
      <span style="color: var(--text-secondary); font-size: 0.85rem;">/ <%= totalPages %></span>
      <button type="button" class="submit-btn" onclick="jumpToPage()" style="padding: 5px 10px; font-size: 0.85rem; margin: 0; min-width: auto; height: auto;">Go</button>
    </div>

    <script>
      function jumpToPage() {
        const input = document.getElementById('pageSearchInput');
        const val = parseInt(input.value, 10);
        const max = parseInt(input.max, 10);
        if (isNaN(val) || val < 1 || val > max) {
          alert('1부터 ' + max + ' 사이의 올바른 페이지 번호를 입력해주세요.');
          return;
        }
        const basePath = '<%= basePath %>';
        const filterParam = '<%= filterParam %>';
        window.location.href = basePath + '?page=' + val + filterParam;
      }
      
      document.getElementById('pageSearchInput').addEventListener('keydown', function(e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          jumpToPage();
        }
      });
    </script>

  </div>
<% } %>
