<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>DarkBrood - 고독과 어둠의 심연</title>
    <meta name="description" content="고독과 어둠, 그리고 증오가 담긴 개인 공간." />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Dark Aero styling -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="stylesheet" href="/css/global.css?v=1.1.0" />
  </head>

  <body>
    <!-- Overlay for background aesthetics -->
    <div id="background"></div>
    
    <div id="websiteContainer">
      <!-- Spacer -->
      <div class="website-spacers"></div>
      
      <!-- Header -->
      <header id="mainHeader">
        <div class="header-logo-text">
          <a href="/" title="홈으로">
            <!-- Dark themed Vista-style logo -->
            <svg id="logo" width="60" height="60" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M15 15C15 15 35 25 35 50C35 75 15 85 15 85V15Z" fill="url(#glassGrad1)" stroke="#b30000" stroke-width="2"/>
              <path d="M85 15C85 15 65 25 65 50C65 75 85 85 85 85V15Z" fill="url(#glassGrad2)" stroke="#b30000" stroke-width="2"/>
              <defs>
                <linearGradient id="glassGrad1" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#3a0000" stop-opacity="0.8"/>
                  <stop offset="100%" stop-color="#000000" stop-opacity="0.9"/>
                </linearGradient>
                <linearGradient id="glassGrad2" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#000000" stop-opacity="0.9"/>
                  <stop offset="100%" stop-color="#2a003a" stop-opacity="0.8"/>
                </linearGradient>
              </defs>
            </svg>
          </a>
          <div class="header-text">
            <span class="header-title">DarkBrood Abyss</span>
            <span class="header-motto">고독과 어둠 속에서 피어난 증오의 기록들.</span>
          </div>
        </div>
        <div class="toggle-buttons-divs">
          <span id="hideNavbarButtonText">Menu &gt;</span>
          <button id="navbarToggleButton">☰</button>
        </div>
      </header>

      <div id="navAndContentContainer">
        <!-- Mobile Sidebar Overlay -->
        <div id="sidebarOverlay"></div>

        <!-- Left Side (Sidebar) -->
        <aside>
          <div id="navigationMenu">
            <!-- Main Content -->
            <nav class="nav-categories" aria-label="Navigation Category: Main Content">
              <span class="navbar-titles">신전 (Shrine)</span>
              <a href="/" class="<%= path === '/' ? 'nav-active' : 'nav-inactive' %>">
                <span class="nav-bullet">✦</span> 소개 (Intro)
              </a>
              <a href="/notice" class="<%= path === '/notice' ? 'nav-active' : 'nav-inactive' %>">
                <span class="nav-bullet">✦</span> 안내 (Notice)
              </a>
            </nav>

            <!-- Personal Diary -->
            <nav class="nav-categories" aria-label="Navigation Category: Operator Diary">
              <span class="navbar-titles">사념 (Diary)</span>
              <a href="/diary" class="<%= path === '/diary' ? 'nav-active' : 'nav-inactive' %>">
                <span class="nav-bullet">✦</span> 일기 (Diary)
              </a>
            </nav>

            <!-- Community -->
            <nav class="nav-categories" aria-label="Navigation Category: Community">
              <span class="navbar-titles">심연 (Community)</span>
              <a href="/community" class="<%= path === '/community' ? 'nav-active' : 'nav-inactive' %>">
                <span class="nav-bullet">✦</span> 광장 (Community)
              </a>
            </nav>

            <!-- User Account / Admin Links -->
            <nav class="nav-categories" aria-label="Navigation Category: Account">
              <span class="navbar-titles">계정 (Account)</span>
              <% if (locals.user) { %>
                <a href="/profile" class="<%= path === '/profile' ? 'nav-active' : 'nav-inactive' %>" style="display: flex; align-items: center; gap: 8px; padding-top: 8px; padding-bottom: 8px;">
                  <% if (user.profilePictureUrl) { %>
                    <img src="<%= user.profilePictureUrl %>" alt="Profile" style="width: 24px; height: 24px; border-radius: 50%; object-fit: cover; border: 1px solid var(--accent-color);" />
                  <% } else { %>
                    <span class="nav-bullet">✦</span>
                  <% } %>
                  <strong><%= user.nickname %></strong>
                </a>
                <a href="/logout" class="nav-inactive">
                  <span class="nav-bullet">✦</span> 로그아웃 (Logout)
                </a>
              <% } else { %>
                <a href="/login" class="<%= path === '/login' ? 'nav-active' : 'nav-inactive' %>">
                  <span class="nav-bullet">✦</span> 로그인 (Login)
                </a>
              <% } %>
              
              <% if (isAdmin) { %>
                <div style="border-top: 1px dashed rgba(255, 255, 255, 0.1); margin: 4px 0;"></div>
                <a href="/logout" class="nav-inactive" style="color: #ff9999;">
                  <span class="nav-bullet" style="color: #ff3333;">✦</span> 관리자 로그아웃
                </a>
              <% } %>
            </nav>

            <!-- Chat Widget (Replaces WMP11 & Audio/Theme toggles) -->
            <div class="chat-widget">
              <div class="chat-title">심연의 메아리 (Echoes)</div>
              <div class="chat-box" id="chatBox">
                <div style="text-align: center; color: #666; padding-top: 50px; font-size: 11px;">연결 중...</div>
              </div>
              <form id="chatForm" class="chat-input-container">
                <input type="text" id="chatInput" maxlength="100" placeholder="메아리 투척..." required autocomplete="off" />
                <button type="submit">전송</button>
              </form>
            </div>
          </div>
        </aside>

        <!-- Middle Content (Dynamic Body) -->
        <main id="mainContent" aria-label="Main Content">
