<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DarkBrood - 심연의 메아리 Standalone Chat</title>
    <!-- Use Google Fonts Outfit / Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&family=Noto+Sans+KR:wght@300;400;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #0b0202;
            --accent-color: #b30000;
            --accent-glow: rgba(179, 0, 0, 0.4);
            --text-color: #e0e0e0;
            --glass-bg: rgba(10, 2, 2, 0.6);
            --glass-border: rgba(179, 0, 0, 0.25);
            --font-size: <%= fontSize %>;
        }

        body {
            margin: 0;
            padding: 0;
            font-family: 'Outfit', 'Noto Sans KR', sans-serif;
            color: var(--text-color);
            background-color: var(--bg-color);
            height: 100vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            box-sizing: border-box;
        }

        /* ----------------------------------------------------
           OVERLAY MODE (Transparent)
           ---------------------------------------------------- */
        <% if (overlay) { %>
        body {
            background: transparent !important;
            background-color: transparent !important;
        }
        #chatPageContainer {
            background: transparent !important;
            border: none !important;
            box-shadow: none !important;
            padding: 0 !important;
            margin: 0 !important;
            height: 100vh !important;
        }
        #chatForm {
            display: none !important;
        }
        .chat-title-bar {
            display: none !important;
        }
        .chat-msg {
            background: transparent !important;
            border: none !important;
            padding: 4px 8px !important;
            margin-bottom: 6px !important;
            /* Drop shadow outline to read text on stream backgrounds */
            text-shadow: 
                -1px -1px 0 #000,  
                 1px -1px 0 #000,
                -1px  1px 0 #000,
                 1px  1px 0 #000,
                0px 0px 4px rgba(0, 0, 0, 0.8) !important;
        }
        .chat-msg-author {
            text-shadow: 
                -1px -1px 0 #000,  
                 1px -1px 0 #000,
                -1px  1px 0 #000,
                 1px  1px 0 #000,
                0px 0px 4px rgba(0, 0, 0, 0.8) !important;
        }
        .chat-msg-time {
            text-shadow: 
                -1px -1px 0 #000,  
                 1px -1px 0 #000,
                -1px  1px 0 #000,
                 1px  1px 0 #000,
                0px 0px 4px rgba(0, 0, 0, 0.8) !important;
            opacity: 0.7 !important;
        }
        .chat-box {
            overflow-y: hidden !important; /* Hide scrollbars in overlay */
            padding-right: 0 !important;
        }
        <% } %>

        /* ----------------------------------------------------
           STANDALONE APP MODE
           ---------------------------------------------------- */
        #chatPageContainer {
            flex: 1;
            display: flex;
            flex-direction: column;
            max-width: 100%;
            height: 100%;
            box-sizing: border-box;
            background: var(--glass-bg);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid var(--glass-border);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        }

        .chat-title-bar {
            padding: 12px 16px;
            background: rgba(0, 0, 0, 0.5);
            border-bottom: 1px solid var(--glass-border);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .chat-title-text {
            font-size: 15px;
            font-weight: 700;
            color: #ff3333;
            text-shadow: 0 0 10px var(--accent-glow);
            letter-spacing: 0.5px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .chat-title-text::before {
            content: "✦";
            animation: pulse 1.5s infinite alternate;
        }

        @keyframes pulse {
            from { opacity: 0.4; }
            to { opacity: 1; }
        }

        .chat-connection-status {
            font-size: 11px;
            color: #00ff66;
            text-shadow: 0 0 5px rgba(0, 255, 102, 0.5);
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .chat-connection-status::before {
            content: "";
            display: inline-block;
            width: 6px;
            height: 6px;
            background-color: #00ff66;
            border-radius: 50%;
            box-shadow: 0 0 8px #00ff66;
        }

        /* ----------------------------------------------------
           CHAT MESSAGE LIST
           ---------------------------------------------------- */
        .chat-box {
            flex: 1;
            overflow-y: auto;
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            scroll-behavior: smooth;
        }

        /* Custom Scrollbar for chat box in standalone mode */
        .chat-box::-webkit-scrollbar {
            width: 6px;
        }
        .chat-box::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.2);
        }
        .chat-box::-webkit-scrollbar-thumb {
            background: var(--accent-color);
            border-radius: 3px;
        }
        .chat-box::-webkit-scrollbar-thumb:hover {
            background: #ff3333;
        }

        .chat-msg {
            background: rgba(255, 255, 255, 0.02);
            border-left: 2px solid var(--accent-color);
            padding: 8px 12px;
            border-radius: 0 6px 6px 0;
            animation: fadeInMsg 0.25s ease-out forwards;
            font-size: var(--font-size);
            line-height: 1.4;
            word-break: break-all;
        }

        @keyframes fadeInMsg {
            from { opacity: 0; transform: translateY(4px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .chat-msg-header {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            margin-bottom: 4px;
            font-size: calc(var(--font-size) - 2px);
        }

        .chat-msg-author {
            color: #aaa;
            font-weight: 500;
        }

        .chat-msg-time {
            color: #666;
            font-size: calc(var(--font-size) - 3px);
        }

        .chat-msg-content {
            color: #e0e0e0;
        }

        /* ----------------------------------------------------
           CHAT FORM & INPUTS
           ---------------------------------------------------- */
        #chatForm {
            padding: 16px;
            background: rgba(0, 0, 0, 0.4);
            border-top: 1px solid var(--glass-border);
            display: flex;
            gap: 10px;
        }

        #chatInput {
            flex: 1;
            background: rgba(0, 0, 0, 0.5);
            border: 1px solid var(--glass-border);
            padding: 10px 14px;
            color: #fff;
            border-radius: 4px;
            font-size: 14px;
            outline: none;
            transition: all 0.25s ease;
        }

        #chatInput:focus {
            border-color: #ff3333;
            box-shadow: 0 0 8px var(--accent-glow);
        }

        #chatForm button {
            background: var(--accent-color);
            color: white;
            border: none;
            padding: 0 18px;
            font-size: 14px;
            font-weight: 600;
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        #chatForm button:hover {
            background: #ff3333;
            box-shadow: 0 0 10px var(--accent-glow);
        }

        #chatForm button:disabled, #chatInput:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
    </style>
</head>
<body>

<div id="chatPageContainer">
    <div class="chat-title-bar">
        <div class="chat-title-text">심연의 메아리 (Standalone Chat)</div>
        <div class="chat-connection-status">연결됨</div>
    </div>
    
    <div class="chat-box" id="chatBox">
        <div style="text-align: center; color: #666; padding-top: 50%; font-size: 12px;">심연과 동기화 중...</div>
    </div>
    
    <form id="chatForm">
        <input type="text" id="chatInput" maxlength="100" placeholder="메아리 투척..." required autocomplete="off" />
        <button type="submit" id="chatSendBtn">전송</button>
    </form>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const chatBox = document.getElementById('chatBox');
        const chatForm = document.getElementById('chatForm');
        const chatInput = document.getElementById('chatInput');
        const chatSendBtn = document.getElementById('chatSendBtn');
        
        let lastTimestamp = 0;
        let isFetching = false;
        let isSending = false;
        const POLL_RATE = 4000; // Stream overlay polling rate slightly faster than main site for responsiveness
        const MAX_MESSAGES = <%= limit %>;

        function escapeHTML(str) {
            return str
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        async function loadChatMessages() {
            // Bypass document.hidden checks for OBS overlay mode to prevent stream freeze when OBS is unfocused/minimized
            if (isFetching || (document.hidden && !<%= overlay %>)) return;
            isFetching = true;

            try {
                const url = lastTimestamp ? `/chat/messages?since=${lastTimestamp}` : '/chat/messages';
                const res = await fetch(url);
                if (!res.ok) throw new Error('Failed to fetch messages');
                const messages = await res.json();
                
                if (messages.length > 0) {
                    const newHTML = messages.map(msg => {
                        const dateStr = new Date(msg.createdAt).toLocaleTimeString('ko-KR', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
                        const authorText = msg.authorNickname ? msg.authorNickname : `익명(${msg.authorIp})`;
                        const authorStyle = msg.authorNickname ? 'style="color: #ff3333; font-weight: 600;"' : '';
                        return `
                            <div class="chat-msg">
                                <div class="chat-msg-header">
                                    <span class="chat-msg-author" ${authorStyle}>${authorText}</span>
                                    <span class="chat-msg-time">${dateStr}</span>
                                </div>
                                <div class="chat-msg-content">${escapeHTML(msg.content)}</div>
                            </div>
                        `;
                    }).join('');

                    if (lastTimestamp === 0) {
                        chatBox.innerHTML = newHTML;
                    } else {
                        chatBox.insertAdjacentHTML('beforeend', newHTML);
                    }
                    
                    lastTimestamp = messages[messages.length - 1].createdAt;
                    
                    // Prune old messages to prevent high memory usage on long stream sessions
                    const currentMsgs = chatBox.querySelectorAll('.chat-msg');
                    if (currentMsgs.length > MAX_MESSAGES) {
                        const toRemoveCount = currentMsgs.length - MAX_MESSAGES;
                        for (let i = 0; i < toRemoveCount; i++) {
                            currentMsgs[i].remove();
                        }
                    }
                    
                    chatBox.scrollTop = chatBox.scrollHeight;
                } else if (lastTimestamp === 0) {
                    chatBox.innerHTML = '<div style="text-align: center; color: #666; padding-top: 50%; font-size: 12px;">침묵만이 흐르는 심연입니다.</div>';
                }
            } catch (err) {
                console.error('Chat load error:', err);
            } finally {
                isFetching = false;
            }
        }

        // Send message handler
        if (chatForm) {
            chatForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const content = chatInput.value.trim();
                if (!content || isSending) return;

                isSending = true;
                chatInput.disabled = true;
                if (chatSendBtn) chatSendBtn.disabled = true;

                try {
                    const res = await fetch('/chat/send', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ content })
                    });
                    if (res.ok) {
                        chatInput.value = '';
                        await loadChatMessages();
                    } else {
                        console.error('Failed to send message:', res.status);
                    }
                } catch (err) {
                    console.error('Chat send error:', err);
                } finally {
                    isSending = false;
                    chatInput.disabled = false;
                    if (chatSendBtn) chatSendBtn.disabled = false;
                    chatInput.focus();
                }
            });
        }

        // Initialize and start polling
        loadChatMessages();
        setInterval(loadChatMessages, POLL_RATE);
    });
</script>

</body>
</html>
