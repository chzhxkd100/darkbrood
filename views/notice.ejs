<%- include('header') %>

<section>
  <header>
    <h1>공지사항 (Notice)</h1>
  </header>

  <% if (isAdmin) { %>
    <!-- Toggle write form button -->
    <div style="margin-bottom: 20px;">
      <button type="button" class="submit-btn" id="toggleWriteBtn" onclick="toggleWriteForm()">새 안내사항 작성</button>
    </div>

    <!-- Notice Write Form (Admin Only) -->
    <div id="writeFormContainer" style="display: none;">
      <div class="glass-borders" style="margin-bottom: 20px;">
        <div class="styled-containers aero-borders">
          <h2>새 안내사항 작성 (Operators Only)</h2>
          <form action="/post/new" method="POST" class="post-form">
            <input type="hidden" name="type" value="notice" />
            <div class="form-group">
              <label for="title">제목</label>
              <input type="text" id="title" name="title" required placeholder="안내사항 제목..." />
            </div>
            <div class="form-group">
              <label for="content">본문</label>
              <textarea id="content" name="content" required rows="5" placeholder="전달할 내용..."></textarea>
            </div>
            <button type="submit" class="submit-btn">심연에 공표하기</button>
          </form>
        </div>
      </div>
    </div>

    <script>
      function toggleWriteForm() {
        var container = document.getElementById('writeFormContainer');
        var btn = document.getElementById('toggleWriteBtn');
        if (container.style.display === 'none') {
          container.style.display = 'block';
          btn.textContent = '작성 취소';
        } else {
          container.style.display = 'none';
          btn.textContent = '새 안내사항 작성';
        }
      }
    </script>
  <% } %>

  <!-- Notice list -->
  <div class="notice-list-container">
    <% if (notices && notices.length > 0) { %>
      <% notices.forEach(notice => { %>
        <div class="glass-borders">
          <article class="styled-containers aero-borders">
            <div class="post-header">
              <span class="post-title"><%= notice.title %></span>
              <span class="post-date" data-timestamp="<%= notice.createdAt %>"></span>
            </div>
            <div class="post-content">
              <%= notice.content %>
            </div>
            <% if (isAdmin) { %>
              <div class="post-admin-actions">
                <form action="/post/<%= notice.id %>/delete" method="POST">
                  <input type="hidden" name="redirectType" value="notice" />
                  <button type="submit" class="admin-del-btn" onclick="return confirm('이 안내사항을 영구 삭제하시겠습니까?')">삭제</button>
                </form>
              </div>
            <% } %>

            <!-- Comments Section -->
            <%- include('partials/comments', { post: notice, redirectType: 'notice' }) %>
          </article>
        </div>
      <% }) %>
    <% } else { %>
      <div class="glass-borders">
        <div class="styled-containers aero-borders" style="text-align: center; color: #888; padding: 30px;">
          안내사항이 존재하지 않습니다.
        </div>
      </div>
    <% } %>
  </div>
</section>

<%- include('footer') %>
