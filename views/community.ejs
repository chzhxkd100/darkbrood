<%- include('header') %>

<section>
  <header>
    <h1>익명 광장 (Community)</h1>
  </header>

  <!-- Toggle write form button -->
  <div style="margin-bottom: 20px;">
    <button type="button" class="submit-btn" id="toggleWriteBtn" onclick="toggleWriteForm()">새 글 쓰기</button>
  </div>

  <!-- Anonymous Post Form -->
  <div id="writeFormContainer" style="display: none;">
    <div class="glass-borders" style="margin-bottom: 20px;">
      <div class="styled-containers aero-borders">
        <h2>익명 글 쓰기 (Post Anonymously)</h2>
        <form action="/community/new" method="POST" enctype="multipart/form-data" class="post-form">
          <input type="hidden" id="imageUrl" name="imageUrl" />
          <div class="form-group">
            <label for="title">제목 (선택)</label>
            <input type="text" id="title" name="title" placeholder="글 제목..." />
          </div>
          <div class="form-group">
            <label for="content">본문 (필수)</label>
            <textarea id="content" name="content" required rows="4" placeholder="세상에 대한 증오나 한탄, 아무 낙서나 적으십시오..."></textarea>
          </div>
          <div class="form-group">
            <label for="image">이미지 첨부 (최대 1개)</label>
            <input type="file" id="image" name="image" accept="image/*" class="file-input" />
            <!-- Upload Progress UI -->
            <div id="uploadProgressContainer" style="display: none; margin-top: 15px;">
              <div class="progress-bar-bg" style="background: rgba(0, 0, 0, 0.6); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 6px; padding: 3px; position: relative; overflow: hidden; height: 18px; box-shadow: inset 0 2px 5px rgba(0,0,0,0.5);">
                <div id="uploadProgressBar" style="width: 0%; height: 100%; background: linear-gradient(90deg, #aa0000, #ff3333); border-radius: 4px; transition: width 0.1s linear; box-shadow: 0 0 10px rgba(255, 51, 51, 0.6);"></div>
              </div>
              <div style="display: flex; justify-content: space-between; margin-top: 6px; font-size: 12px; color: #ccc;">
                <span id="uploadProgressText">심연으로 전송 준비 중... (0%)</span>
                <span id="uploadProgressSpeed">0.00 MB/s</span>
              </div>
            </div>
          </div>
          <button type="submit" class="submit-btn">심연에 투척하기</button>
        </form>
      </div>
    </div>
  </div>

  <script>
    function toggleWriteForm() {
      var container = document.getElementById('writeFormContainer');
      var btn = document.getElementById('toggleWriteBtn');
      if (container.style.display === 'none') {
        container.style.display = 'block';
        btn.textContent = '작성 취소';
      } else {
        container.style.display = 'none';
        btn.textContent = '새 글 쓰기';
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      const form = document.querySelector('.post-form');
      if (!form) return;

      form.addEventListener('submit', async (e) => {
        const fileInput = document.getElementById('image');
        const file = fileInput ? fileInput.files[0] : null;

        // If no file selected, let the form submit normally
        if (!file) return;

        // Prevent default submission to upload the file first
        e.preventDefault();

        const submitBtn = form.querySelector('.submit-btn');
        const progressContainer = document.getElementById('uploadProgressContainer');
        const progressBar = document.getElementById('uploadProgressBar');
        const progressText = document.getElementById('uploadProgressText');
        const progressSpeed = document.getElementById('uploadProgressSpeed');
        const imageUrlInput = document.getElementById('imageUrl');

        // Disable submit button and set text inputs to readOnly to prevent edits during upload
        submitBtn.disabled = true;
        submitBtn.textContent = '업로드 중...';
        if (fileInput) fileInput.disabled = true;
        const textInputs = form.querySelectorAll('input[type="text"], textarea');
        textInputs.forEach(input => input.readOnly = true);

        // Show progress bar
        progressContainer.style.display = 'block';
        progressBar.style.width = '0%';
        progressBar.style.background = 'linear-gradient(90deg, #aa0000, #ff3333)';
        progressText.textContent = '심연으로 전송 시작... (0%)';
        progressSpeed.textContent = '0.00 MB/s';

        const chunkSize = 2 * 1024 * 1024; // 2MB chunk size
        const totalChunks = Math.ceil(file.size / chunkSize);
        const uploadId = 'upload_' + Date.now() + '_' + Math.random().toString(36).substring(2, 15);
        
        let totalUploadedBytes = 0;
        const startTime = Date.now();

        try {
          for (let chunkIndex = 0; chunkIndex < totalChunks; chunkIndex++) {
            const start = chunkIndex * chunkSize;
            const end = Math.min(start + chunkSize, file.size);
            const chunk = file.slice(start, end);

            const formData = new FormData();
            formData.append('chunk', chunk);

            const response = await fetch(`/upload/chunk?uploadId=${uploadId}&chunkIndex=${chunkIndex}`, {
              method: 'POST',
              body: formData
            });

            if (!response.ok) {
              throw new Error(`청크 업로드 실패 (${chunkIndex + 1}/${totalChunks})`);
            }

            totalUploadedBytes += chunk.size;
            const elapsedSeconds = (Date.now() - startTime) / 1000;
            const speedMBps = elapsedSeconds > 0 ? (totalUploadedBytes / (1024 * 1024)) / elapsedSeconds : 0;
            const percentage = Math.round((totalUploadedBytes / file.size) * 100);

            progressBar.style.width = percentage + '%';
            progressText.textContent = `심연으로 전송 중... (${percentage}%)`;
            progressSpeed.textContent = `${speedMBps.toFixed(2)} MB/s`;
          }

          progressText.textContent = '파편들 봉합 중...';
          const completeResponse = await fetch('/upload/complete', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              uploadId,
              filename: file.name,
              totalChunks
            })
          });

          if (!completeResponse.ok) {
            const errText = await completeResponse.text();
            throw new Error(errText || '파일 병합 실패');
          }

          const result = await completeResponse.json();
          if (!result.success || !result.url) {
            throw new Error('올바른 파일 URL을 받지 못했습니다.');
          }

          // Set hidden field URL
          imageUrlInput.value = result.url;
          progressText.textContent = '업로드 완료!';
          progressBar.style.background = 'linear-gradient(90deg, #00aa00, #33ff33)';

          // Clear file input so browser doesn't post it again
          fileInput.disabled = false;
          fileInput.value = '';
          fileInput.remove(); // Remove the element from form entirely

          // Submit the form
          form.submit();

        } catch (err) {
          console.error(err);
          progressText.textContent = '업로드 오류 발생';
          progressBar.style.background = '#ff0000';
          alert('파일 업로드 중 오류가 발생했습니다: ' + err.message);

          // Re-enable form fields for retry
          submitBtn.disabled = false;
          submitBtn.textContent = '심연에 투척하기';
          if (fileInput) fileInput.disabled = false;
          textInputs.forEach(input => input.readOnly = false);
        }
      });
    });
  </script>

  <!-- Filter notification if active -->
  <% if (locals.authorFilter) { %>
    <div class="glass-borders" style="margin-bottom: 20px;">
      <div class="styled-containers aero-borders" style="display: flex; justify-content: space-between; align-items: center; padding: 12px 15px;">
        <span style="color: #fff; font-size: 13.5px;">
          <strong style="color: var(--accent-color);"><%= authorFilter %></strong> 님의 글을 필터링 중입니다.
        </span>
        <a href="/community" class="submit-btn" style="text-decoration: none; padding: 4px 12px; font-size: 12px;">전체 보기</a>
      </div>
    </div>
  <% } %>

  <!-- Search Filter Notification -->
  <% if (locals.searchQuery) { %>
    <div class="glass-borders" style="margin-bottom: 20px;">
      <div class="styled-containers aero-borders" style="display: flex; justify-content: space-between; align-items: center; padding: 12px 15px;">
        <span style="color: #fff; font-size: 13.5px;">
          검색어 <strong style="color: var(--accent-color);">"<%= searchQuery %>"</strong> (검색 분류: <%= searchType === 'title' ? '제목' : (searchType === 'content' ? '내용' : (searchType === 'author' ? '작성자' : '통합')) %>) 검색 결과입니다.
        </span>
        <a href="/community" class="submit-btn" style="text-decoration: none; padding: 4px 12px; font-size: 12px;">전체 보기</a>
      </div>
    </div>
  <% } %>

  <!-- Search Bar -->
  <div class="glass-borders" style="margin-bottom: 20px;">
    <form action="/community" method="GET" style="display: flex; gap: 8px; padding: 10px; align-items: center; margin: 0;" class="styled-containers aero-borders">
      <select name="searchType" style="background: rgba(0,0,0,0.6); color: #fff; border: 1px solid rgba(255,255,255,0.1); border-radius: 4px; padding: 8px 12px; font-size: 13px; outline: none; cursor: pointer;">
        <option value="all" <%= locals.searchType === 'all' ? 'selected' : '' %>>통합 검색</option>
        <option value="title" <%= locals.searchType === 'title' ? 'selected' : '' %>>제목</option>
        <option value="content" <%= locals.searchType === 'content' ? 'selected' : '' %>>내용</option>
        <option value="author" <%= locals.searchType === 'author' ? 'selected' : '' %>>작성자</option>
      </select>
      <input type="text" name="searchQuery" value="<%= locals.searchQuery || '' %>" placeholder="심연 검색..." required style="flex: 1; background: rgba(0,0,0,0.6); border: 1px solid rgba(255,255,255,0.1); border-radius: 4px; color: #fff; padding: 8px 12px; font-size: 13px; outline: none;" />
      <button type="submit" class="submit-btn" style="padding: 8px 15px; font-size: 13px; margin: 0; white-space: nowrap;">검색</button>
    </form>
  </div>

  <!-- Anonymous Posts list -->
  <div class="community-list-container">
    <% if (posts && posts.length > 0) { %>
      <% posts.forEach(post => { %>
        <div class="glass-borders" id="post-<%= post.id %>">
          <article class="styled-containers aero-borders community-post">
            <!-- Post Info Header -->
            <div class="post-header">
              <span class="post-author" style="display: inline-flex; align-items: center; gap: 8px;">
                <% if (post.authorNickname && post.authorId) { %>
                  <% if (locals.usersMap && usersMap[post.authorNickname]) { %>
                    <img src="<%= usersMap[post.authorNickname] %>" alt="Profile" style="width: 36px; height: 36px; border-radius: 50%; object-fit: cover; border: 2px solid var(--accent-color); box-shadow: 0 0 5px var(--accent-glow);" />
                  <% } %>
                  <a href="/profile/<%= post.authorId %>" title="<%= post.authorNickname %> 님의 프로필 보기" style="color: #cc6666; font-weight: bold; text-decoration: underline; font-size: 14px;">
                    <%= post.authorNickname %>
                  </a>
                <% } else if (post.authorNickname) { %>
                  <!-- Legacy/Admin without ID -->
                  <span style="color: #cc6666; font-weight: bold; font-size: 14px;"><%= post.authorNickname %></span>
                <% } else { %>
                  <a href="/community?author=<%= encodeURIComponent(post.authorIp) %>" title="익명(<%= post.authorIp %>) 님의 글만 보기" style="color: #cc6666; font-weight: bold; text-decoration: underline; font-size: 14px;">
                    익명 (<%= post.authorIp %>)
                  </a>
                <% } %>
              </span>
              <span class="post-date" data-timestamp="<%= post.createdAt %>"></span>
              <% 
                let canDelete = false;
                let deleteLabel = "삭제";
                if (isAdmin) {
                  canDelete = true;
                  deleteLabel = "삭제 (운영자)";
                } else if (user && (post.authorId === user.id || post.authorNickname === user.nickname)) {
                  canDelete = true;
                } else if (post.authorIp && locals.anonId && post.authorIp === anonId) {
                  canDelete = true;
                }
              %>
              <% if (canDelete) { %>
                <form action="/post/<%= post.id %>/delete" method="POST" style="display:inline; margin-left: 10px;">
                  <input type="hidden" name="redirectType" value="community" />
                  <button type="submit" class="admin-del-btn" onclick="return confirm('이 글을 영구 삭제하시겠습니까?')"><%= deleteLabel %></button>
                </form>
              <% } %>
            </div>
            
            <!-- Post Subject -->
            <% if (post.title && post.title !== '무제') { %>
              <h3 class="community-subject"><%= post.title %></h3>
            <% } %>
 
            <!-- Post Body (Flex wrapper for image and text) -->
            <div class="post-body">
              <% if (post.imageUrl) { %>
                <div class="post-image-container">
                  <a href="<%= post.imageUrl %>" class="lightbox-trigger" title="클릭하여 확대">
                    <img src="<%= post.imageUrl %>" alt="첨부 이미지" class="post-thumbnail" />
                  </a>
                </div>
              <% } %>
              <div class="post-text-content">
                <%= post.content %>
              </div>
            </div>
 
            <!-- Comments Section -->
            <%- include('partials/comments', { post: post, redirectType: 'community' }) %>
          </article>
        </div>
      <% }) %>
    <% } else { %>
      <div class="glass-borders">
        <div class="styled-containers aero-borders" style="text-align: center; color: #888; padding: 30px;">
          광장이 텅 비어 있습니다. 익명으로 글을 남겨 어둠을 채워주세요.
        </div>
      </div>
    <% } %>
  </div>

  <!-- Pagination Controls -->
  <%- include('partials/pagination', { 
      currentPage: currentPage, 
      totalPages: totalPages, 
      basePath: '/community', 
      filterParam: (locals.authorFilter ? '&author=' + encodeURIComponent(authorFilter) : '') + 
                   (locals.searchQuery ? '&searchQuery=' + encodeURIComponent(searchQuery) + '&searchType=' + encodeURIComponent(searchType) : '')
  }) %>
</section>

<%- include('footer') %>
