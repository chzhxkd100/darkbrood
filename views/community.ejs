<%- include('header') %>

<section>
  <header>
    <h1>익명 광장 (Community)</h1>
  </header>

  <!-- Toggle write form button -->
  <div style="margin-bottom: 20px;">
    <button type="button" class="submit-btn" id="toggleWriteBtn" onclick="toggleWriteForm()">새 글 쓰기</button>
  </div>

  <!-- Anonymous Post Form -->
  <div id="writeFormContainer" style="display: none;">
    <div class="glass-borders" style="margin-bottom: 20px;">
      <div class="styled-containers aero-borders">
        <h2>익명 글 쓰기 (Post Anonymously)</h2>
        <form action="/community/new" method="POST" enctype="multipart/form-data" class="post-form">
          <div class="form-group">
            <label for="title">제목 (선택)</label>
            <input type="text" id="title" name="title" placeholder="글 제목..." />
          </div>
          <div class="form-group">
            <label for="content">본문 (필수)</label>
            <textarea id="content" name="content" required rows="4" placeholder="세상에 대한 증오나 한탄, 아무 낙서나 적으십시오..."></textarea>
          </div>
          <div class="form-group">
            <label for="image">이미지 첨부 (최대 1개)</label>
            <input type="file" id="image" name="image" accept="image/*" class="file-input" />
          </div>
          <button type="submit" class="submit-btn">심연에 투척하기</button>
        </form>
      </div>
    </div>
  </div>

  <script>
    function toggleWriteForm() {
      var container = document.getElementById('writeFormContainer');
      var btn = document.getElementById('toggleWriteBtn');
      if (container.style.display === 'none') {
        container.style.display = 'block';
        btn.textContent = '작성 취소';
      } else {
        container.style.display = 'none';
        btn.textContent = '새 글 쓰기';
      }
    }
  </script>

  <!-- Anonymous Posts list -->
  <div class="community-list-container">
    <% if (posts && posts.length > 0) { %>
      <% posts.forEach(post => { %>
        <div class="glass-borders">
          <article class="styled-containers aero-borders community-post">
            <!-- Post Info Header -->
            <div class="post-header">
              <span class="post-author">
                <% if (post.authorNickname) { %>
                  <%= post.authorNickname %>
                <% } else { %>
                  익명 (<%= post.authorIp %>)
                <% } %>
              </span>
              <span class="post-date" data-timestamp="<%= post.createdAt %>"></span>
              <% if (isAdmin) { %>
                <form action="/post/<%= post.id %>/delete" method="POST" style="display:inline; margin-left: 10px;">
                  <input type="hidden" name="redirectType" value="community" />
                  <button type="submit" class="admin-del-btn" onclick="return confirm('이 익명 글을 영구 삭제하시겠습니까?')">삭제</button>
                </form>
              <% } %>
            </div>
            
            <!-- Post Subject -->
            <% if (post.title && post.title !== '무제') { %>
              <h3 class="community-subject"><%= post.title %></h3>
            <% } %>

            <!-- Post Body (Flex wrapper for image and text) -->
            <div class="post-body">
              <% if (post.imageUrl) { %>
                <div class="post-image-container">
                  <a href="<%= post.imageUrl %>" target="_blank" title="클릭하여 원본 보기">
                    <img src="<%= post.imageUrl %>" alt="첨부 이미지" class="post-thumbnail" />
                  </a>
                </div>
              <% } %>
              <div class="post-text-content">
                <%= post.content %>
              </div>
            </div>

            <!-- Comments Section -->
            <div class="comments-section styled-containers-layer-2 aero-borders">
              <div class="comments-list">
                <% if (post.comments && post.comments.length > 0) { %>
                  <% post.comments.forEach(comment => { %>
                    <div class="comment-item">
                      <span class="comment-author">
                        <% if (comment.authorNickname) { %>
                          <%= comment.authorNickname %>
                        <% } else { %>
                          匿名 (<%= comment.authorIp %>)
                        <% } %>
                      </span>
                      <span class="comment-date" data-timestamp="<%= comment.createdAt %>"></span>
                      <div class="comment-text"><%= comment.content %></div>
                    </div>
                  <% }) %>
                <% } else { %>
                  <p class="no-comments">댓글이 없습니다. 첫 번째 파편을 던져보세요.</p>
                <% } %>
              </div>

              <!-- Quick Comment Reply Form -->
              <form action="/community/<%= post.id %>/comment" method="POST" class="comment-form">
                <input type="text" name="content" required placeholder="익명 댓글 작성..." class="comment-input" />
                <button type="submit" class="comment-submit-btn">댓글</button>
              </form>
            </div>
          </article>
        </div>
      <% }) %>
    <% } else { %>
      <div class="glass-borders">
        <div class="styled-containers aero-borders" style="text-align: center; color: #888; padding: 30px;">
          광장이 텅 비어 있습니다. 익명으로 글을 남겨 어둠을 채워주세요.
        </div>
      </div>
    <% } %>
  </div>

  <!-- Pagination Controls -->
  <% if (totalPages > 1) { %>
    <div class="pagination-container" style="display: flex; justify-content: center; align-items: center; gap: 8px; margin-top: 25px; margin-bottom: 25px;">
      <% if (currentPage > 1) { %>
        <a href="/community?page=<%= currentPage - 1 %>" class="submit-btn" style="text-decoration: none; padding: 6px 12px; font-size: 0.9rem;">이전</a>
      <% } %>
      
      <% for (let i = 1; i <= totalPages; i++) { %>
        <% if (i === currentPage) { %>
          <span class="submit-btn" style="padding: 6px 12px; font-size: 0.9rem; background: rgba(255,255,255,0.25); border-color: rgba(255,255,255,0.5); cursor: default; box-shadow: 0 0 10px rgba(255,255,255,0.3);"><%= i %></span>
        <% } else { %>
          <a href="/community?page=<%= i %>" class="submit-btn" style="text-decoration: none; padding: 6px 12px; font-size: 0.9rem;"><%= i %></a>
        <% } %>
      <% } %>

      <% if (currentPage < totalPages) { %>
        <a href="/community?page=<%= currentPage + 1 %>" class="submit-btn" style="text-decoration: none; padding: 6px 12px; font-size: 0.9rem;">다음</a>
      <% } %>
    </div>
  <% } %>
</section>

<%- include('footer') %>
