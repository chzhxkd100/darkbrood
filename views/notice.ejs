<%- include('header') %>

<section>
  <header>
    <h1>공지사항 (Notice)</h1>
  </header>

  <% if (isAdmin) { %>
    <!-- Toggle write form button -->
    <div style="margin-bottom: 20px;">
      <button type="button" class="submit-btn" id="toggleWriteBtn" onclick="toggleWriteForm()">새 안내사항 작성</button>
    </div>

    <!-- Notice Write Form (Admin Only) -->
    <div id="writeFormContainer" style="display: none;">
      <div class="glass-borders" style="margin-bottom: 20px;">
        <div class="styled-containers aero-borders">
          <h2>새 안내사항 작성 (Operators Only)</h2>
          <form action="/post/new" method="POST" enctype="multipart/form-data" class="post-form">
            <input type="hidden" name="type" value="notice" />
            <div class="form-group">
              <label for="title">제목</label>
              <input type="text" id="title" name="title" required placeholder="안내사항 제목..." />
            </div>
            <div class="form-group">
              <label for="content">본문</label>
              <textarea id="content" name="content" required rows="5" placeholder="전달할 내용..."></textarea>
            </div>
            <div class="form-group">
              <label for="image">이미지 첨부 (최대 1개)</label>
              <input type="file" id="image" name="image" accept="image/*" class="file-input" />
              <!-- File preview container -->
              <div id="filePreviewContainer" style="display: none; flex-wrap: wrap; gap: 8px; margin-top: 10px;"></div>
            </div>
            <button type="submit" class="submit-btn">심연에 공표하기</button>
          </form>
        </div>
      </div>
    </div>

    <script>
      function toggleWriteForm() {
        var container = document.getElementById('writeFormContainer');
        var btn = document.getElementById('toggleWriteBtn');
        if (container.style.display === 'none') {
          container.style.display = 'block';
          btn.textContent = '작성 취소';
        } else {
          container.style.display = 'none';
          btn.textContent = '새 안내사항 작성';
        }
      }

      document.addEventListener('DOMContentLoaded', () => {
        const fileInput = document.getElementById('image');
        const previewContainer = document.getElementById('filePreviewContainer');
        const contentTextarea = document.getElementById('content');
        
        if (!fileInput || !previewContainer) return;
        
        function updateSinglePreview(file) {
          // Revoke old object URLs to avoid memory leaks
          const oldImgs = previewContainer.querySelectorAll('img');
          oldImgs.forEach(img => {
            if (img.src && img.src.startsWith('blob:')) {
              URL.revokeObjectURL(img.src);
            }
          });
          previewContainer.innerHTML = '';
          
          if (!file) {
            previewContainer.style.display = 'none';
            return;
          }
          
          previewContainer.style.display = 'flex';
          
          const item = document.createElement('div');
          item.style.position = 'relative';
          item.style.width = '80px';
          item.style.height = '80px';
          
          const img = document.createElement('img');
          img.src = URL.createObjectURL(file);
          img.style.width = '100%';
          img.style.height = '100%';
          img.style.objectFit = 'cover';
          img.style.borderRadius = '6px';
          img.style.border = '1px solid rgba(255, 255, 255, 0.15)';
          img.style.boxShadow = '0 2px 8px rgba(0, 0, 0, 0.5)';
          
          item.title = file.name;
          
          const removeBtn = document.createElement('button');
          removeBtn.type = 'button';
          removeBtn.textContent = '✕';
          removeBtn.style.position = 'absolute';
          removeBtn.style.top = '-6px';
          removeBtn.style.right = '-6px';
          removeBtn.style.background = 'rgba(10, 10, 10, 0.85)';
          removeBtn.style.border = '1px solid rgba(255, 255, 255, 0.2)';
          removeBtn.style.borderRadius = '50%';
          removeBtn.style.color = 'var(--accent-color)';
          removeBtn.style.cursor = 'pointer';
          removeBtn.style.width = '18px';
          removeBtn.style.height = '18px';
          removeBtn.style.display = 'flex';
          removeBtn.style.alignItems = 'center';
          removeBtn.style.justifyContent = 'center';
          removeBtn.style.fontSize = '9px';
          removeBtn.style.fontWeight = 'bold';
          removeBtn.style.boxShadow = '0 2px 4px rgba(0,0,0,0.5)';
          removeBtn.style.padding = '0';
          removeBtn.style.transition = 'all 0.2s';
          
          removeBtn.onmouseover = () => {
            removeBtn.style.borderColor = 'var(--accent-color)';
            removeBtn.style.boxShadow = '0 0 5px var(--accent-glow)';
          };
          removeBtn.onmouseout = () => {
            removeBtn.style.borderColor = 'rgba(255, 255, 255, 0.2)';
            removeBtn.style.boxShadow = '0 2px 4px rgba(0,0,0,0.5)';
          };
          
          removeBtn.addEventListener('click', () => {
            fileInput.value = '';
            updateSinglePreview(null);
          });
          
          item.appendChild(img);
          item.appendChild(removeBtn);
          previewContainer.appendChild(item);
        }
        
        fileInput.addEventListener('change', () => {
          if (fileInput.files && fileInput.files[0]) {
            updateSinglePreview(fileInput.files[0]);
          } else {
            updateSinglePreview(null);
          }
        });
        
        if (contentTextarea) {
          contentTextarea.addEventListener('paste', (e) => {
            const files = e.clipboardData?.files || e.originalEvent?.clipboardData?.files;
            if (files && files[0]) {
              const file = files[0];
              if (file.type.startsWith('image/')) {
                e.preventDefault();
                const extension = file.type.split('/')[1] || 'png';
                const newFile = new File([file], `pasted-image-${Date.now()}.${extension}`, { type: file.type });
                
                const dataTransfer = new DataTransfer();
                dataTransfer.items.add(newFile);
                fileInput.files = dataTransfer.files;
                
                updateSinglePreview(newFile);
              }
            }
          });
        }
      });
    </script>
  <% } %>

  <!-- Notice list -->
  <div class="notice-list-container">
    <% if (notices && notices.length > 0) { %>
      <% notices.forEach(notice => { %>
        <div class="glass-borders" id="post-<%= notice.id %>">
          <article class="styled-containers aero-borders">
            <div class="post-header">
              <span class="post-title"><%= notice.title %></span>
              <span class="post-date" data-timestamp="<%= notice.createdAt %>"></span>
            </div>
            <div class="post-body post-content">
              <% if (notice.imageUrl) { %>
                <div class="post-image-container">
                  <a href="<%= notice.imageUrl %>" class="lightbox-trigger" title="클릭하여 확대">
                    <img src="<%= notice.imageUrl %>" alt="첨부 이미지" class="post-thumbnail" />
                  </a>
                </div>
              <% } %>
              <div class="post-text-content">
                <%= notice.content %>
              </div>
            </div>
            <% if (isAdmin) { %>
              <div class="post-admin-actions">
                <form action="/post/<%= notice.id %>/delete" method="POST">
                  <input type="hidden" name="redirectType" value="notice" />
                  <button type="submit" class="admin-del-btn" onclick="return confirm('이 안내사항을 영구 삭제하시겠습니까?')">삭제</button>
                </form>
              </div>
            <% } %>

            <!-- Comments Section -->
            <%- include('partials/comments', { post: notice, redirectType: 'notice' }) %>
          </article>
        </div>
      <% }) %>
    <% } else { %>
      <div class="glass-borders">
        <div class="styled-containers aero-borders" style="text-align: center; color: #888; padding: 30px;">
          안내사항이 존재하지 않습니다.
        </div>
      </div>
    <% } %>
  </div>

  <!-- Pagination Controls -->
  <%- include('partials/pagination', { 
      currentPage: currentPage, 
      totalPages: totalPages, 
      basePath: '/notice', 
      filterParam: '' 
  }) %>
</section>

<%- include('footer') %>
