<%- include('header') %>

<section>
  <header>
    <h1>플레이리스트 (Playlist)</h1>
  </header>

  <div style="margin-bottom: 20px;">
    <button type="button" class="submit-btn" id="toggleUploadBtn" onclick="toggleUploadForm()">음원 추가</button>
  </div>

  <!-- Upload Form -->
  <div id="uploadFormContainer" style="display: none; margin-bottom: 20px;">
    <div class="glass-borders">
      <div class="styled-containers aero-borders">
        <h2>음원 추가</h2>
        <form id="playlistUploadForm" enctype="multipart/form-data" class="post-form">
          <div class="form-group">
            <label for="pageBgmFile">오디오 파일 (MP3, WAV 등 여러 파일 선택 가능)</label>
            <input type="file" name="audio" id="pageBgmFile" accept=".mp3,.wav,.ogg,.m4a,audio/*" required multiple class="file-input" />
            <div id="fileSelectionNote" style="font-size: 11.5px; color: var(--accent-color); margin-top: 4px; display: none;"></div>
          </div>
          <div class="form-group">
            <label for="pageBgmTitle">곡 제목 (선택, 파일 1개일 때 적용)</label>
            <input type="text" name="title" id="pageBgmTitle" placeholder="제목 (미입력 시 파일명 사용)" maxlength="60" />
          </div>
          <div class="form-group">
            <label for="pageBgmArtist">아티스트 (선택)</label>
            <input type="text" name="artist" id="pageBgmArtist" placeholder="아티스트 (선택사항, 미입력 시 제목만 표시)" maxlength="40" />
          </div>
          <div id="bgmUploadProgressWrap" style="display: none; margin-top: 14px; margin-bottom: 6px; padding: 12px 14px; background: rgba(5, 10, 8, 0.85); border: 1px solid rgba(57, 255, 20, 0.35); border-radius: 6px; box-shadow: 0 4px 15px rgba(0, 0, 0, 0.6), 0 0 10px rgba(57, 255, 20, 0.15);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
              <span id="bgmProgressStage" style="font-size: 12px; font-weight: 600; color: #39ff14;">📤 파일 전송 준비 중...</span>
              <span id="bgmProgressPercent" style="font-family: 'Consolas', 'Courier New', monospace; font-size: 13px; font-weight: bold; color: #39ff14; text-shadow: 0 0 5px rgba(57, 255, 20, 0.6);">0%</span>
            </div>
            <div style="width: 100%; height: 7px; background: rgba(255, 255, 255, 0.12); border-radius: 4px; overflow: hidden; position: relative;">
              <div id="bgmProgressBar" style="width: 0%; height: 100%; background: linear-gradient(90deg, #1db954, #39ff14); box-shadow: 0 0 8px #39ff14; transition: width 0.15s ease; border-radius: 4px;"></div>
            </div>
            <div id="bgmProgressDetail" style="font-size: 11px; color: var(--text-secondary); margin-top: 6px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"></div>
          </div>
          <button type="submit" id="pageBgmSubmitBtn" class="submit-btn" style="margin-top: 8px;">업로드</button>
        </form>
      </div>
    </div>
  </div>

  <!-- Playlist Table -->
  <div class="glass-borders">
    <div class="styled-containers aero-borders">
      <div class="playlist-table-wrapper">
        <table class="playlist-table" style="width: 100%; border-collapse: collapse; font-size: 13px;">
          <thead>
            <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.15); text-align: left; color: var(--text-secondary); font-size: 12px;">
              <th style="padding: 10px; width: 45px; text-align: center;">재생</th>
              <th style="padding: 10px;">곡 제목</th>
              <th style="padding: 10px;">아티스트</th>
              <th style="padding: 10px;">등록자</th>
              <th style="padding: 10px; width: 95px;">등록일</th>
              <% if (isAdmin) { %>
                <th style="padding: 10px; width: 55px; text-align: center;">삭제</th>
              <% } %>
            </tr>
          </thead>
          <tbody id="playlistTableBody">
            <% if (tracks && tracks.length > 0) { %>
              <% tracks.forEach((track) => { %>
                <tr class="playlist-row" data-id="<%= track.id %>" onclick="window.playBgmTrackById('<%= track.id %>')">
                  <td style="padding: 10px; text-align: center;">
                    <button type="button" class="row-play-btn" title="Play">▶</button>
                  </td>
                  <td style="padding: 10px; font-weight: bold; color: var(--text-primary);">
                    <span class="row-title"><%= track.title %></span>
                  </td>
                  <td style="padding: 10px; color: var(--text-secondary);"><%= (track.artist && track.artist !== '익명') ? track.artist : '-' %></td>
                  <td style="padding: 10px; color: var(--text-secondary);"><%= track.uploaderName %></td>
                  <td style="padding: 10px; font-size: 12px; color: #888;">
                    <%= track.createdAt ? new Date(track.createdAt).toLocaleDateString('ko-KR') : '-' %>
                  </td>
                  <% if (isAdmin) { %>
                    <td style="padding: 10px; text-align: center;" onclick="event.stopPropagation()">
                      <button type="button" class="admin-del-btn" onclick="window.deleteBgmTrack('<%= track.id %>', event)">삭제</button>
                    </td>
                  <% } %>
                </tr>
              <% }); %>
            <% } else { %>
              <tr id="emptyPlaylistRow">
                <td colspan="<%= isAdmin ? 6 : 5 %>" style="text-align: center; padding: 30px; color: #777;">
                  등록된 음원이 없습니다.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<script>
window.toggleUploadForm = function() {
  const container = document.getElementById('uploadFormContainer');
  const btn = document.getElementById('toggleUploadBtn');
  if (!container || !btn) return;
  if (container.style.display === 'none') {
    container.style.display = 'block';
    btn.textContent = '작성 취소';
  } else {
    container.style.display = 'none';
    btn.textContent = '음원 추가';
  }
};

(function() {
  const form = document.getElementById('playlistUploadForm');
  const fileInput = document.getElementById('pageBgmFile');
  const fileNote = document.getElementById('fileSelectionNote');
  if (!form || !fileInput) return;

  fileInput.addEventListener('change', function() {
    const files = fileInput.files;
    if (!files || files.length === 0) {
      if (fileNote) fileNote.style.display = 'none';
      return;
    }
    if (fileNote) {
      fileNote.style.display = 'block';
      if (files.length === 1) {
        fileNote.textContent = `선택된 파일: ${files[0].name}`;
      } else {
        fileNote.textContent = `총 ${files.length}개의 파일이 선택되었습니다. (각 파일명이 곡 제목으로 자동 등록됩니다)`;
      }
    }
  });

  form.addEventListener('submit', function(e) {
    e.preventDefault();
    if (!fileInput.files || fileInput.files.length === 0) {
      alert('업로드할 오디오 파일을 선택해주세요.');
      return;
    }

    const files = Array.from(fileInput.files);
    let totalBytes = 0;
    for (let i = 0; i < files.length; i++) {
      if (files[i].size > 30 * 1024 * 1024) {
        alert(`파일 "${files[i].name}"의 크기가 30MB를 초과합니다.`);
        return;
      }
      totalBytes += files[i].size;
    }

    const submitBtn = document.getElementById('pageBgmSubmitBtn');
    const progressWrap = document.getElementById('bgmUploadProgressWrap');
    const stageEl = document.getElementById('bgmProgressStage');
    const percentEl = document.getElementById('bgmProgressPercent');
    const barEl = document.getElementById('bgmProgressBar');
    const detailEl = document.getElementById('bgmProgressDetail');
    const fileCount = files.length;

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = '처리 중...';
    }

    if (progressWrap) progressWrap.style.display = 'block';
    if (barEl) {
      barEl.style.width = '0%';
      barEl.style.background = 'linear-gradient(90deg, #1db954, #39ff14)';
    }
    if (percentEl) percentEl.textContent = '0%';
    if (stageEl) {
      stageEl.style.color = '#39ff14';
      stageEl.textContent = fileCount > 1 ? `📤 파일 업로드 중... (총 ${fileCount}곡)` : '📤 파일 업로드 중...';
    }
    if (detailEl) {
      detailEl.style.color = 'var(--text-secondary)';
      detailEl.textContent = `0.0 MB / ${(totalBytes / 1024 / 1024).toFixed(1)} MB`;
    }

    const formData = new FormData(form);
    const xhr = new XMLHttpRequest();
    let normTimer = null;

    // Phase 1: Real-time File Upload
    xhr.upload.onprogress = function(event) {
      if (event.lengthComputable) {
        const uploadPct = Math.round((event.loaded / event.total) * 100);
        if (barEl) barEl.style.width = uploadPct + '%';
        if (percentEl) percentEl.textContent = uploadPct + '%';
        if (stageEl) {
          stageEl.textContent = fileCount > 1 
            ? `📤 파일 업로드 중... (${uploadPct}%)` 
            : `📤 파일 업로드 중... (${uploadPct}%)`;
        }
        if (detailEl) {
          detailEl.textContent = `${(event.loaded / 1024 / 1024).toFixed(1)} MB / ${(event.total / 1024 / 1024).toFixed(1)} MB 전송 완료`;
        }
      }
    };

    // Phase 2: Loudness Normalization (Loudnorm & MP3 Transcode on Server)
    xhr.upload.onload = function() {
      if (barEl) barEl.style.width = '0%';
      if (percentEl) percentEl.textContent = '0%';
      
      const estimatedSec = Math.max(3.5, fileCount * 3.8);
      const intervalMs = 90;
      const totalSteps = (estimatedSec * 1000) / intervalMs;
      let step = 0;

      normTimer = setInterval(() => {
        step++;
        const ratio = 1 - Math.exp(-2.6 * (step / totalSteps));
        const normPct = Math.min(96, Math.max(1, Math.round(ratio * 100)));

        if (barEl) barEl.style.width = normPct + '%';
        if (percentEl) percentEl.textContent = normPct + '%';

        if (fileCount > 1) {
          const currentTrackNum = Math.min(fileCount, Math.floor((normPct / 100) * fileCount) + 1);
          if (stageEl) stageEl.textContent = `🎛️ [${currentTrackNum}/${fileCount}곡] 음량 평준화 분석 및 변환 중... (${normPct}%)`;
          if (detailEl) detailEl.textContent = `EBU R128 표준 음량(-16 LUFS) 및 192kbps MP3 인코딩 중...`;
        } else {
          if (stageEl) stageEl.textContent = `🎛️ 음량 평준화 분석 및 변환 중... (${normPct}%)`;
          if (detailEl) detailEl.textContent = `EBU R128 국제 표준(-16 LUFS) 및 192k MP3 인코딩 중...`;
        }
      }, intervalMs);
    };

    xhr.onload = function() {
      if (normTimer) clearInterval(normTimer);

      try {
        const data = JSON.parse(xhr.responseText);
        if (xhr.status === 200 && data.success) {
          // Phase 3: Complete!
          if (barEl) {
            barEl.style.width = '100%';
            barEl.style.background = 'linear-gradient(90deg, #39ff14, #00ffcc)';
          }
          if (percentEl) percentEl.textContent = '100%';
          if (stageEl) {
            stageEl.style.color = '#39ff14';
            stageEl.textContent = '✨ 음량 평준화 및 등록 완료! (100%)';
          }
          if (detailEl) {
            detailEl.textContent = fileCount > 1 
              ? `총 ${fileCount}곡의 평준화 변환과 저장이 모두 완료되었습니다!` 
              : '음원의 평준화 변환과 저장이 완료되었습니다!';
          }

          setTimeout(() => {
            form.reset();
            if (fileNote) fileNote.style.display = 'none';
            if (progressWrap) progressWrap.style.display = 'none';
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = '업로드';
            }
            window.toggleUploadForm();

            const newTracks = data.tracks || [data.track];
            if (window.addNewBgmTracks) {
              window.addNewBgmTracks(newTracks);
            } else if (window.addNewBgmTrack) {
              window.addNewBgmTrack(newTracks[0]);
            } else {
              location.reload();
            }
          }, 750);
        } else {
          showError(data.error || '음원 등록에 실패했습니다.');
        }
      } catch (err) {
        showError('서버 응답 처리 중 오류가 발생했습니다.');
      }
    };

    xhr.onerror = function() {
      if (normTimer) clearInterval(normTimer);
      showError('네트워크 오류가 발생했습니다.');
    };

    function showError(msg) {
      if (barEl) barEl.style.background = '#ff6b6b';
      if (stageEl) {
        stageEl.style.color = '#ff6b6b';
        stageEl.textContent = '❌ 등록 실패';
      }
      if (detailEl) {
        detailEl.style.color = '#ff6b6b';
        detailEl.textContent = msg;
      }
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = '다시 시도';
      }
    }

    xhr.open('POST', '/api/bgm/upload');
    xhr.send(formData);
  });
})();
</script>

<%- include('footer') %>
