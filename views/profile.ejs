<%- include('header') %>

<section>
  <header>
    <h1>계정 프로필 (Profile)</h1>
  </header>

  <div class="glass-borders" style="margin-bottom: 20px; max-width: 600px; margin-left: auto; margin-right: auto;">
    <div class="styled-containers aero-borders">
      <div style="text-align: center; margin-bottom: 20px;">
        <% if (userData.profilePictureUrl) { %>
          <img src="<%= userData.profilePictureUrl %>" alt="Profile Picture" style="width: 120px; height: 120px; border-radius: 50%; border: 2px solid var(--accent-color); object-fit: cover; box-shadow: 0 0 10px rgba(0,0,0,0.5);" />
        <% } else { %>
          <div style="width: 120px; height: 120px; border-radius: 50%; border: 2px dashed #666; display: flex; align-items: center; justify-content: center; margin: 0 auto; color: #666; font-size: 12px;">
            No Image
          </div>
        <% } %>
        <h2 style="margin-top: 15px; color: #fff;"><%= userData.nickname %></h2>
        <p style="color: #888; font-size: 12px;">가입일: <%= new Date(userData.createdAt).toLocaleDateString('ko-KR') %></p>
      </div>

      <div style="border-top: 1px dashed rgba(255, 255, 255, 0.2); padding-top: 20px; margin-top: 20px;">
        <h3 style="margin-bottom: 15px; font-size: 14px;">프로필 사진 변경</h3>
        <form action="/profile/update" method="POST" enctype="multipart/form-data" class="post-form">
          <div class="form-group">
            <label for="profilePic">이미지 파일 (최대 5MB)</label>
            <input type="file" id="profilePic" name="profilePic" accept="image/*" class="file-input" required />
          </div>
          <button type="submit" class="submit-btn" style="width: 100%;">사진 업데이트</button>
        </form>
      </div>
    </div>
  </div>

</section>

<%- include('footer') %>
